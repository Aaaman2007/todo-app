{
  // Run the Flask app with the debugger attached.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: todo app",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "1"
      },
      "args": ["run", "--no-reload", "--port", "5000"],
      "jinja": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: app.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
