# ---------------------------------------------------------------------------
# Copy this file for local development:
#
#     cp .env.example .env
#
# Then replace SECRET_KEY (command below). .env is git-ignored and is NOT used
# by Railway - Railway reads the variables set in its own dashboard/CLI.
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Real environment variables always take precedence over this file.
# ---------------------------------------------------------------------------

# --- local development -----------------------------------------------------
PORT=5000
DATABASE=./todos.db
FLASK_DEBUG=1
COOKIE_SECURE=0
SECRET_KEY=replace-me-with-64-random-hex-characters

# --- Railway / production --------------------------------------------------
# Set these in Railway -> your service -> Variables, not in this file.
# The values below are what a volume-backed production service needs:
#
# PORT=5000                 # must equal the public domain's target port
# COOKIE_SECURE=1           # cookies only over HTTPS
# FLASK_DEBUG=0             # never run the debugger in production
# DATABASE=/data/todos.db   # requires a volume mounted at /data
# SECRET_KEY=<64 hex chars> # a fresh value; see the command above
